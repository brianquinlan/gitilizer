{
  "displayName": "gitilizer.com: more than 5% of requests failing",
  "documentation": { "content": "More than 5% of requests to gitilizer-api returned 5xx for 10 minutes. Look for ERROR lines in Cloud Logging (resource.type=cloud_run_revision, service gitilizer-api). If a release caused it, roll back: DEPLOYMENT.md, \"Rolling back\".", "mimeType": "text/markdown" },
  "combiner": "OR",
  "conditions": [{
    "displayName": "5xx ratio above 5% for 10 minutes",
    "conditionThreshold": {
      "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"gitilizer-api\" AND metric.label.response_code_class=\"5xx\"",
      "aggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM" }],
      "denominatorFilter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"gitilizer-api\"",
      "denominatorAggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM" }],
      "comparison": "COMPARISON_GT", "thresholdValue": 0.05, "duration": "600s"
    }
  }],
  "notificationChannels": ["CHANNEL"]
}
