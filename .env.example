# Copy to .env and fill in. .env is gitignored.
# Used by the eval tools and by npm run local (contributor/LOCAL_DEVELOPMENT.md).
GEMINI_API_KEY=
# Optional: keys for the other ranking agents, for evals (--model claude-haiku-5-5
# or gpt-6-luna) and for switching agents in local mode.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GitHub personal access token (classic or fine-grained with public read).
GITHUB_TOKEN=
# Optional: override the model used for prioritization.
# GITILIZER_MODEL=gemini-3.8-flash
