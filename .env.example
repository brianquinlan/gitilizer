# Copy to .env and fill in. .env is gitignored.
# Used by the eval tools and by npm run local (contributor/LOCAL_DEVELOPMENT.md).
GEMINI_API_KEY=
# Optional: keys for the other ranking agents, for evals (--model claude-sonnet-5-5
# or gpt-6.1-sol) and for switching agents in local mode.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GitHub personal access token (classic or fine-grained with public read).
GITHUB_TOKEN=
# Optional: override the model used for prioritization.
# GITILIZER_MODEL=gemini-3.8-flash
# Optional: a GitHub App of your own, so "Connect GitHub" works in local mode
# (contributor/LOCAL_DEVELOPMENT.md). Its callback URL must be
# http://localhost:5173/api/connect/github/callback. The slug is the last part
# of the app's page, https://github.com/apps/<slug>; the whole link works too.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
